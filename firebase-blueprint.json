{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Library": {
      "title": "Library",
      "description": "A collection of books.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "access": {
          "type": "object",
          "description": "Map of user emails to their access level.",
          "additionalProperties": { "type": "string", "enum": ["owner", "editor", "viewer"] }
        },
        "heroImageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "createdAt"]
    },
    "Book": {
      "title": "Book",
      "description": "A book in a library.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "isbn": { "type": "string" },
        "coverUrl": { "type": "string" },
        "publishedDate": { "type": "string" },
        "genres": {
          "type": "array",
          "items": { "type": "string" }
        },
        "series": { "type": "string" },
        "format": { "type": "string", "enum": ["physical", "digital"] },
        "userStatuses": { 
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["unset", "reading", "finished", "abandoned"] }
        },
        "addedAt": { "type": "string", "format": "date-time" },
        "addedBy": { "type": "string" }
      },
      "required": ["title", "addedAt", "addedBy"]
    },
    "BookDetails": {
      "title": "BookDetails",
      "description": "Heavy data for a book in a library. Linked 1-to-1 with a Book by using the exact same document ID.",
      "type": "object",
      "properties": {
        "synopsis": { "type": "string" },
        "authorBio": { "type": "string" },
        "clusterCoordinates": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "embedding": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Generated semantic vector embedding of the book synopsis for clustering."
        }
      }
    },
    "Review": {
      "title": "Review",
      "description": "A review for a book. Stored as a subcollection under the specific Book document.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "rating", "text", "createdAt"]
    },
    "AllowedDuplicate": {
      "title": "AllowedDuplicate",
      "description": "A group of book IDs that are allowed to be duplicates.",
      "type": "object",
      "properties": {
        "bookIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookIds", "createdAt"]
    },
    "Job": {
      "title": "Job",
      "description": "A background task for a library.",
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["running", "completed", "failed"] },
        "progress": { "type": "number" },
        "total": { "type": "number" },
        "error": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["status", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles."
    },
    "/libraries/{libraryId}": {
      "schema": { "$ref": "#/entities/Library" },
      "description": "Libraries owned by users."
    },
    "/libraries/{libraryId}/allowedDuplicates/{allowedId}": {
      "schema": { "$ref": "#/entities/AllowedDuplicate" },
      "description": "Dismissed duplicate suggestions within a library."
    },
    "/libraries/{libraryId}/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Background tasks for a library."
    },
    "/libraries/{libraryId}/books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Books within a library."
    },
    "/libraries/{libraryId}/bookDetails/{bookId}": {
      "schema": { "$ref": "#/entities/BookDetails" },
      "description": "Heavy data for books within a library."
    },
    "/libraries/{libraryId}/books/{bookId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reviews for a book."
    }
  }
}
