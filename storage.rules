rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 100% of storage mutations route through the Node.js tRPC Gateway using firebase-admin/storage.
    // Direct client-side writes to Cloud Storage are strictly forbidden.
    match /libraries/{libraryId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
